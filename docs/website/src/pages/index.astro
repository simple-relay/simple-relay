  {
    name: "Shopify",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M15.337 23.979l7.216-1.561s-2.604-17.613-2.625-17.73c-.018-.116-.114-.192-.211-.192s-1.929-.136-1.929-.136-1.275-1.274-1.439-1.411c-.045-.037-.075-.057-.121-.074l-.914 21.104h.023zM11.71 11.305s-.81-.424-1.774-.424c-1.447 0-1.504.906-1.504 1.141 0 1.232 3.24 1.715 3.24 4.629 0 2.295-1.44 3.76-3.406 3.76-2.354 0-3.54-1.465-3.54-1.465l.646-2.086s1.245 1.066 2.28 1.066c.675 0 .975-.545.975-.932 0-1.619-2.654-1.694-2.654-4.359-.034-2.237 1.571-4.416 4.827-4.416 1.257 0 1.875.361 1.875.361l-.945 2.715-.02.01zM11.17.83c.136 0 .271.038.405.135-.984.465-2.064 1.639-2.508 3.992-.656.213-1.293.405-1.889.578C7.697 3.75 8.951.84 11.17.84V.83zm1.235 2.949v.135c-.754.232-1.583.484-2.394.736.466-1.777 1.333-2.645 2.085-2.971.193.501.309 1.176.309 2.1zm.539-2.234c.694.074 1.141.867 1.429 1.755-.349.114-.735.231-1.158.366v-.252c0-.752-.096-1.371-.271-1.871v.002zm2.992 1.289c-.02 0-.06.021-.078.021s-.289.075-.714.21c-.423-1.233-1.176-2.37-2.508-2.37h-.115C12.135.209 11.669 0 11.265 0 8.159 0 6.675 3.877 6.21 5.846c-1.194.365-2.063.636-2.16.674-.675.213-.694.232-.772.87-.075.462-1.83 14.063-1.83 14.063L15.009 24l.927-21.166z"/></svg>`,
  },
  {
    name: "GitHub",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"/></svg>`,
  },
  {
    name: "Slack",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/></svg>`,
  },
  {
    name: "LINE",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>`,
  },
  {
    name: "Messenger",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.24 0 0 4.952 0 11.64c0 3.499 1.434 6.521 3.769 8.61a.96.96 0 0 1 .323.683l.065 2.135a.96.96 0 0 0 1.347.85l2.381-1.053a.96.96 0 0 1 .641-.046A13 13 0 0 0 12 23.28c6.76 0 12-4.952 12-11.64S18.76 0 12 0m6.806 7.44c.522-.03.971.567.63 1.094l-4.178 6.457a.707.707 0 0 1-.977.208l-3.87-2.504a.44.44 0 0 0-.49.007l-4.363 3.01c-.637.438-1.415-.317-.995-.966l4.179-6.457a.706.706 0 0 1 .977-.21l3.87 2.505c.15.097.344.094.491-.007l4.362-3.008a.7.7 0 0 1 .364-.13"/></svg>`,
  },
  {
    name: "PayPal",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M15.607 4.653H8.941L6.645 19.251H1.82L4.862 0h7.995c3.754 0 6.375 2.294 6.473 5.513-.648-.478-2.105-.86-3.722-.86m6.57 5.546c0 3.41-3.01 6.853-6.958 6.853h-2.493L11.595 24H6.74l1.845-11.538h3.592c4.208 0 7.346-3.634 7.153-6.949a5.24 5.24 0 0 1 2.848 4.686M9.653 5.546h6.408c.907 0 1.942.222 2.363.541-.195 2.741-2.655 5.483-6.441 5.483H8.714Z"/></svg>`,
  },
  {
    name: "Webhooks",
    svg: `<svg class="w-8 h-8 sm:w-9 sm:h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9A4 4 0 0 1 2 17c.01-.7.2-1.4.57-2"/><path d="m6 17 3.13-5.78c.53-.97.1-2.18-.5-3.1a4 4 0 1 1 6.89-4.06"/><path d="m12 6 3.13 5.73C15.66 12.7 16.9 13 18 13a4 4 0 0 1 0 8"/></svg>`,
  },
];
---

<Layout includeSoftwareSchema={true}>
  <!-- ═══════════════════════════════════════════════
       GLOBAL NAV — 64px, Apple-style
  ═══════════════════════════════════════════════ -->
  <SiteHeader isHome={true} />

  <!-- ═══════════════════════════════════════════════
       SECTION 1 — HERO (Light tile / canvas white)
  ═══════════════════════════════════════════════ -->
  <section class="w-full bg-canvas py-[80px] px-5">
    <div class="max-w-[680px] mx-auto text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-8 px-3.5 py-1.5 rounded-pill bg-[#e8f0fb] text-primary text-[13px] font-medium tracking-[-0.01em]">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
        Open Source
      </div>

      <!-- H1 -->
      <h1 class="text-[clamp(36px,7vw,56px)] font-semibold leading-[1.07] tracking-[-0.028em] text-ink mb-5">
        One binary.<br/>No infrastructure.<br/>
        <span class="text-primary">Reliable HTTP delivery.</span>
      </h1>

      <!-- H2 Subhead -->
      <p class="text-[clamp(17px,2.5vw,21px)] font-light text-[#6e6e73] leading-[1.5] mb-10 max-w-[520px] mx-auto">
        A tiny self-hosted HTTP relay. Receive HTTP. Forward HTTP.<br class="hidden sm:block"/>
        Make delivery reliable.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-4 mb-12">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-primary text-white text-[17px] font-normal px-[22px] py-[11px] rounded-pill hover:bg-[#0077ed] active:scale-95 transition-all duration-150"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"/>
          </svg>
          View on GitHub
        </a>
        <a
          href={DOCS_URL}
          class="inline-flex items-center gap-1.5 text-primary text-[17px] font-normal px-[22px] py-[11px] rounded-pill border border-primary hover:bg-[#f0f6ff] active:scale-95 transition-all duration-150"
        >
          Read the Docs
          <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
      </div>

      <!-- Quick Start Terminal with Copy & Tabs -->
      <div class="w-full max-w-[580px] mx-auto rounded-[14px] bg-[#1d1d1f] text-left overflow-hidden shadow-product border border-white/10" id="quickstart-box">
        <!-- Terminal title bar with Tabs -->
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-white/10 bg-[#141416]">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f57]" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e]" aria-hidden="true"></span>
            <span class="w-3 h-3 rounded-full bg-[#28c840]" aria-hidden="true"></span>
            <!-- Tabs -->
            <div class="flex items-center ml-2 bg-black/40 p-0.5 rounded-[6px] border border-white/5">
              <button
                type="button"
                id="tab-btn-docker"
                class="px-2.5 py-1 text-[11px] font-medium rounded-[4px] bg-white/15 text-white transition-colors cursor-pointer"
                onclick="switchQuickstart('docker')"
              >
                Docker
              </button>
              <button
                type="button"
                id="tab-btn-binary"
                class="px-2.5 py-1 text-[11px] font-medium rounded-[4px] text-[#a1a1a6] hover:text-white transition-colors cursor-pointer"
                onclick="switchQuickstart('binary')"
              >
                Standalone Binary
              </button>
            </div>
          </div>

          <!-- Copy Button -->
          <button
            type="button"
            id="copy-quickstart-btn"
            class="flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-mono text-[#a1a1a6] hover:text-white bg-white/5 hover:bg-white/10 rounded-[6px] transition-colors cursor-pointer"
            onclick="copyQuickstartCommand()"
            aria-label="Copy command to clipboard"
          >
            <i data-lucide="copy" class="w-3.5 h-3.5" id="copy-icon"></i>
            <span id="copy-text">Copy</span>
          </button>
        </div>

        <!-- Terminal content: Docker tab -->
        <div id="content-docker" class="px-5 py-4 font-mono text-[13px] leading-6">
          <div class="flex items-start gap-2">
            <span class="text-[#0066cc] select-none">$</span>
            <div class="text-white select-all">
              <span>docker run -d --name simple-relay \</span><br/>
              <span class="pl-2">-p 8080:8080 -v relay-data:/data \</span><br/>
              <span class="pl-2">-e RELAY_DB_PATH=/data/relay.db \</span><br/>
              <span class="pl-2">ghcr.io/simple-relay/simple-relay:latest</span>
            </div>
          </div>
          <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-[#6e6e73]">
            <span class="flex items-center gap-1.5 text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Listening on :8080
            </span>
            <span>Dashboard at <code class="text-[#a1a1a6] bg-white/10 px-1 py-0.5 rounded">http://localhost:8080/ui/</code></span>
          </div>
        </div>

        <!-- Terminal content: Binary tab -->
        <div id="content-binary" class="hidden px-5 py-4 font-mono text-[13px] leading-6">
          <div class="flex items-start gap-2">
            <span class="text-[#0066cc] select-none">$</span>
            <div class="text-white select-all">
              <span>curl -fsSL https://raw.githubusercontent.com/simple-relay/simple-relay/main/install.sh | sh</span><br/>
              <span>relay</span>
            </div>
          </div>
          <div class="mt-3 pt-2.5 border-t border-white/5 flex items-center justify-between text-[11px] text-[#6e6e73]">
            <span class="flex items-center gap-1.5 text-emerald-400">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Linux &amp; macOS (amd64 / arm64)
            </span>
            <span>Windows: <a href="https://github.com/simple-relay/simple-relay/releases" target="_blank" rel="noopener noreferrer" class="text-[#a1a1a6] hover:text-white underline">GitHub Releases &rarr;</a></span>
          </div>
        </div>
      </div>

      <script is:inline>
        let currentTab = 'docker';
        const commands = {
          docker: "docker run -d --name simple-relay -p 8080:8080 -v relay-data:/data -e RELAY_DB_PATH=/data/relay.db ghcr.io/simple-relay/simple-relay:latest",
          binary: "curl -fsSL https://raw.githubusercontent.com/simple-relay/simple-relay/main/install.sh | sh && relay"
        };

        function switchQuickstart(tab) {
          currentTab = tab;
          const dockerContent = document.getElementById('content-docker');
          const binaryContent = document.getElementById('content-binary');
          const dockerBtn = document.getElementById('tab-btn-docker');
          const binaryBtn = document.getElementById('tab-btn-binary');

          if (tab === 'docker') {
            dockerContent?.classList.remove('hidden');
            binaryContent?.classList.add('hidden');
            dockerBtn?.classList.add('bg-white/15', 'text-white');
            dockerBtn?.classList.remove('text-[#a1a1a6]');
            binaryBtn?.classList.remove('bg-white/15', 'text-white');
            binaryBtn?.classList.add('text-[#a1a1a6]');
          } else {
            binaryContent?.classList.remove('hidden');
            dockerContent?.classList.add('hidden');
            binaryBtn?.classList.add('bg-white/15', 'text-white');
            binaryBtn?.classList.remove('text-[#a1a1a6]');
            dockerBtn?.classList.remove('bg-white/15', 'text-white');
            dockerBtn?.classList.add('text-[#a1a1a6]');
          }
        }

        function copyQuickstartCommand() {
          const text = commands[currentTab];
          navigator.clipboard.writeText(text).then(() => {
            const copyText = document.getElementById('copy-text');
            if (copyText) {
              copyText.innerText = 'Copied!';
              setTimeout(() => {
                copyText.innerText = 'Copy';
              }, 2000);
            }
          });
        }
      </script>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 2 — SOCIAL PROOF (Parchment tile)
  ═══════════════════════════════════════════════ -->
  <section class="w-full bg-parchment py-16 px-5" aria-label="Trusted integrations">
    <div class="max-w-[680px] mx-auto text-center mb-10">
      <p class="text-[#6e6e73] text-[17px] leading-[1.47] tracking-[-0.022em]">
        Designed to reliably handle webhooks and APIs from:
      </p>
    </div>

    <!-- Static logo strip -->
    <div class="w-full max-w-6xl mx-auto px-4 flex flex-wrap items-center justify-center gap-x-10 sm:gap-x-14 md:gap-x-16 gap-y-10" aria-hidden="true">
      {socialProofLogos.map((logo) => (
        <div class="flex flex-col items-center gap-2.5 opacity-50 hover:opacity-100 transition-opacity duration-200 group">
          <div class="w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center text-[#1d1d1f] group-hover:text-primary transition-colors duration-200" set:html={logo.svg} />
          <span class="text-[12px] text-[#6e6e73] group-hover:text-ink font-medium tracking-[0.04em] uppercase transition-colors duration-200">{logo.name}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       SECTION 3 — "AHA" MOMENT (Dark tile)
       Old Way vs Simple Relay
  ═══════════════════════════════════════════════ -->
  <section class="w-full bg-tile-1 py-[80px] px-5" id="comparison" aria-labelledby="comparison-heading">
    <div class="max-w-[980px] mx-auto">
      <!-- Section heading -->
      <div class="text-center mb-16">
        <p class="text-[#2997ff] text-[14px] font-semibold tracking-[0.08em] uppercase mb-3">The Problem</p>
        <h2 id="comparison-heading" class="text-[clamp(28px,5vw,40px)] font-semibold text-white leading-[1.1] tracking-[-0.022em]">
          Stop overengineering reliability.
        </h2>
        <p class="mt-4 text-[#a1a1a6] text-[17px] leading-[1.47] tracking-[-0.022em] max-w-[480px] mx-auto">
          Durable delivery shouldn't require a distributed systems degree.
        </p>
      </div>

      <!-- Comparison diagram: CSS-only animated -->
      <div class="grid md:grid-cols-2 gap-6 max-w-[860px] mx-auto">

        <!-- LEFT: Old Way -->
        <div class="bg-[#2a2a2c] rounded-[18px] p-8 border border-white/10">
          <div class="flex items-center gap-2 mb-6">
            <span class="px-2.5 py-1 bg-red-500/20 text-red-400 text-[11px] font-semibold rounded-pill uppercase tracking-wider">
              Overkill &amp; Expensive
            </span>
          </div>
