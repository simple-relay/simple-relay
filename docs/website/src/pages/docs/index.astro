---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

const allDocs = await getCollection('docs');
const sortedDocs = [...allDocs].sort((a, b) => a.data.order - b.data.order);
const firstDoc = sortedDocs[0];

const { Content, headings } = await render(firstDoc);

const allDocSummaries = allDocs.map((d) => ({
  slug: d.id.replace(/\.md$/, ''),
  title: d.data.title,
  section: d.data.section,
  order: d.data.order,
}));
---

<DocsLayout
  title={firstDoc.data.title}
  description={firstDoc.data.description}
  currentSlug={firstDoc.id.replace(/\.md$/, '')}
  allDocs={allDocSummaries}
  headings={headings}
>
  <Content />
</DocsLayout>
